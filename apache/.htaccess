# php2shell (CVE-2026-109618 / CVE-2026-109619) - UNOFFICIAL, PROVISIONAL mitigation.
# Blocks multipart/form-data requests before they reach PHP.
# WARNING: it also blocks legitimate uploads and multipart forms. Use it only on paths that
# never receive uploads. The real fix is updating PHP.
#
# Why this regex: PHP lowercases the Content-Type and truncates it at the first ';', ',' or
# space, then looks for "boundary" anywhere in the header. So "multipart/form-data,boundary=x"
# is multipart to PHP, and the comma variant has to be caught too.
# Use %{HTTP:Content-Type} (the raw header), NOT %{CONTENT_TYPE}: with mod_rewrite the latter
# often matches nothing.
RewriteEngine On
RewriteCond %{REQUEST_METHOD} ^(POST|PUT|PATCH)$ [NC]
RewriteCond %{HTTP:Content-Type} ^[[:space:]]*multipart/form-data([;,[:space:]]|$) [NC]
RewriteRule ^ - [F,L]
